#!/usr/bin/env bash
# `just preflight` before a push leaves: a red one costs a CI run and a review
# run. `mise exec -- just setup` turns the hooks on.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
# a hook runs before any justfile, so mise.toml's just may not be on PATH yet
if command -v just >/dev/null; then just=(just); else just=(mise exec -- just); fi
exec "${just[@]}" preflight
