#!/usr/bin/env bash
# Formatting only: pre-push runs `just preflight`, and CI the rest.
# `mise exec -- just setup` turns the hooks on.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
# mise.toml's just, which the justfile is written for, over any older one on
# PATH; a bare just only where there is no mise
if command -v mise >/dev/null; then just=(mise exec -- just); else just=(just); fi
"${just[@]}" fmt-check || {
    echo "[pre-commit] 'just fmt-check' failed, above; 'cargo fmt --all' fixes a formatting diff" >&2
    exit 1
}
